def cpu_limit():
    n = len(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else (os.cpu_count() or 1)
    try:  # cgroup v2 quota (containers)
        q, p = open("/sys/fs/cgroup/cpu.max").read().split()
        if q != "max":
            n = min(n, max(1, int(int(q) // int(p))))
    except (OSError, ValueError):
        pass
    # a cap for the default on a shared machine (scripts that do not write "workers" themselves,
    # e.g. the regression check); the request's own "workers" still wins. Results do not depend on it.
    cap = os.environ.get("FXOPT_WORKERS", "").strip()
    if cap.isdigit() and int(cap) >= 1:
        n = min(n, int(cap))
    return n


def breakdown(pb, wl):
    b = {"gain_out": 0, "gain_param": 0, "sum_accum": 0, "sum_out": 0,
         "unit_delay": (pb.nt - 1) * pb.xt[1], "input_port": pb.xt[1]}
    for s in range(pb.ns):
        o = s * pb.nvar_stage
        b["gain_param"] += sum(wl[o:o + pb.nt])
        b["gain_out"] += sum(wl[o + pb.nt:o + 2 * pb.nt])
        b["sum_accum"] += wl[o + 2 * pb.nt]
        b["sum_out"] += wl[o + 2 * pb.nt + 1]
        if s + 1 < pb.ns:
            b["unit_delay"] += (pb.nt - 1) * wl[o + 2 * pb.nt + 1]
    b["total"] = sum(b.values())
    return b


def strict_max_err(where, ov, want_type, ref, nsteps):
    """max |y - ref| only after checking that the re-simulated output has the solution's type and
    exactly nsteps in-range integer samples, and that the reference has nsteps finite values."""
    got = (ov.get("s"), ov.get("wl"), ov.get("fl"))
    if tuple(want_type) != got:
        raise L.OptError("VERIFY_FAILED", where, "re-simulated output type %s differs from the solution's %s"
                         % (got, tuple(want_type)))
    ints = ov.get("ints")
    if not isinstance(ints, list) or len(ints) != nsteps:
        raise L.OptError("VERIFY_FAILED", where, "re-simulated output has %s samples, expected %d"
                         % (len(ints) if isinstance(ints, list) else "no", nsteps))
    if len(ref) != nsteps or not all(math.isfinite(y) for y in ref):
        raise L.OptError("VERIFY_FAILED", where, "reference has %d samples (expected %d) or non-finite values"
                         % (len(ref), nsteps))
    s_, w_, f_ = want_type
    lo, hi = (-(1 << (w_ - 1)), (1 << (w_ - 1)) - 1) if s_ else (0, (1 << w_) - 1)
    if not all(isinstance(v, int) and not isinstance(v, bool) and lo <= v <= hi for v in ints):
        raise L.OptError("VERIFY_FAILED", where, "re-simulated output has values outside its type")
    sc = 2.0 ** -f_
    md, at = 0.0, 0
    from fractions import Fraction
    for i, (v, y) in enumerate(zip(ints, ref)):
        # a value with more than 53 significant bits is compared exactly, not through double
        d = abs(v * sc - y) if float(v) == v else float(abs(Fraction(v) * Fraction(2) ** -f_ - Fraction(y)))
        if d > md:
            md, at = d, i
    return md, at


def _fixdt_tuple(text):
    import re
    m = re.match(r"^fixdt\((\d+),\s*(\d+),\s*(-?\d+)\)$", text.strip())
    if not m:
        raise L.OptError("INTERNAL", "solution", "solution type %r is not fixdt(s,w,f)" % text)
    return int(m.group(1)), int(m.group(2)), int(m.group(3))


def verify_independent(pb, blocks, yref):
    """Re-simulate the final solution with the validated fxchain CLI (separate front-end and planner)
    and compare with the pure-Python double reference."""
    req = {"design": {"nstages": pb.ns, "ntaps": pb.nt}, "blocks": blocks,
           "x": {"s": pb.xt[0], "wl": pb.xt[1], "fl": pb.xt[2], "ints": pb.x}, "outputs": "final"}
    p = subprocess.run([os.path.join(HERE, "fxchain")], input=json.dumps(req).encode(), capture_output=True,
                       timeout=600)
    lines = p.stdout.decode().splitlines()
    if p.returncode != 0 or len(lines) != 1:
        raise L.OptError("VERIFY_FAILED", "engine/fxchain", "fxchain exited with code %d and %d result lines"
                         % (p.returncode, len(lines)))
    try:
        o = json.loads(lines[0])
    except ValueError:
        raise L.OptError("VERIFY_FAILED", "engine/fxchain", "fxchain result is not JSON")
    if o.get("status") != "ok":
        raise L.OptError("VERIFY_FAILED", "engine/fxchain", "fxchain error %s: %s" % (o.get("code"), o.get("message")))
    outs = o.get("outputs") or {}
    ft = outs.get("final_type") or {}
    want = _fixdt_tuple(blocks["Acc%d" % pb.ns]["OutDataTypeStr"])
    md, at = strict_max_err("engine/fxchain", dict(ft, ints=outs.get("final")), want, yref, len(pb.x))
    summ = outs.get("stages_summary") or []
    if len(summ) != pb.ns:
        raise L.OptError("VERIFY_FAILED", "engine/fxchain", "%d stage summaries, expected %d" % (len(summ), pb.ns))
    return md, at, summ[-1]["fnv1a64"]


WALL_START = [time.time()]  # wall-clock start of the request being solved (set per request)
CURRENT_RUN = {}  # run directory of the request being solved (for the failure state), reset per request


def _atomic_json(path, obj):
    tmp = "%s.tmp%d" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(obj, f)
        f.write("\n")
    os.replace(tmp, path)


def open_run_dir(req, sha):
    """every execution gets its own attempt id and an exclusively created directory. An explicit
    log_dir must not exist yet (no silent append / overwrite; there is no resume)."""
    attempt = "%s-%s-%d-%s" % (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), sha[:16], os.getpid(),
                               os.urandom(4).hex())
    explicit = req.get("log_dir")
    if explicit is not None and not isinstance(explicit, str):
        raise L.OptError("BAD_PARAM", "log_dir", "directory path string required")
    if explicit and not os.path.isabs(explicit):   # relative to the project directory, whatever the cwd
        explicit = os.path.join(os.path.dirname(RUNS), explicit)
    run_dir = os.path.abspath(explicit if explicit else os.path.join(RUNS, "fxopt", sha[:16], attempt))
    if not (run_dir + os.sep).startswith(os.path.abspath(RUNS) + os.sep):
        raise L.OptError("BAD_PARAM", "log_dir", "log_dir must be inside runs/")
    os.makedirs(os.path.dirname(run_dir), exist_ok=True)
    try:
        os.mkdir(run_dir)
    except FileExistsError:
        raise L.OptError("LOG_DIR_EXISTS", "log_dir", "%s already exists; every run needs a new directory (there "
                         "is no resume)" % os.path.relpath(run_dir, ROOT))
    # the first directory of a request is the request's (its result.json is the final answer); the re-optimisations'
    # directories are passes (second cold start: the top-level result.json kept a solution the error search
    # had rejected and state.json stayed "running")
    first = not CURRENT_RUN
    if first:
        CURRENT_RUN.update(dir=run_dir, attempt=attempt, sha=sha, passes=[], t0=time.monotonic(),
                           phase="optimisation", extra={})
    else:
        CURRENT_RUN["passes"].append(run_dir)
    _atomic_json(os.path.join(run_dir, "state.json"), {"attempt_id": attempt, "request_sha256": sha,
                                                        "state": "running", "pid": os.getpid(),
                                                        "phase": "optimisation" if run_dir == CURRENT_RUN["dir"]
                                                        else "re-optimisation (pass)", "elapsed_s": 0.0,
                                                        "heartbeat_s": HEARTBEAT_S})
    if first:
        _start_heartbeat()
    with open(os.path.join(run_dir, "request.json"), "x") as f:
        json.dump(req, f)
    return run_dir, attempt


# state.json of a running request is rewritten at every phase change and at least every HEARTBEAT_S seconds
# (during a long first pass it kept its initial snapshot, so a running and a stuck run looked alike)
HEARTBEAT_S = float(os.environ.get("FXOPT_HEARTBEAT_S", "10"))
_STATE_LOCK = threading.Lock()


def _write_running_state():
    run = CURRENT_RUN
    if not run:
        return
    try:
        _atomic_json(os.path.join(run["dir"], "state.json"),
                     dict({"attempt_id": run["attempt"], "request_sha256": run["sha"], "state": "running",
                           "pid": os.getpid(), "phase": run["phase"],
                           "elapsed_s": round(time.monotonic() - run["t0"], 1), "heartbeat_s": HEARTBEAT_S},
                          **run["extra"]))
    except OSError:
        pass


def _start_heartbeat():
    run = CURRENT_RUN
    stop = threading.Event()
    run["stop"] = stop

    def beat():
        while not stop.wait(HEARTBEAT_S):
            with _STATE_LOCK:
                if stop.is_set() or CURRENT_RUN.get("stop") is not stop:
                    return
                _write_running_state()
    threading.Thread(target=beat, daemon=True).start()


def set_phase(phase, **extra):
    """Progress of the running request in its state.json (stdout stays silent for minutes)."""
    with _STATE_LOCK:
        if not CURRENT_RUN:
            return
        CURRENT_RUN["phase"], CURRENT_RUN["extra"] = phase, extra
        _write_running_state()


def close_run_dir(out):
    """Final state of the request's run directory: result.json (atomic) = the final answer, state done / failed with
    the final location; every pass directory is marked as an interim pass superseded by it."""
    with _STATE_LOCK:   # no heartbeat may overwrite the final state
        run = dict(CURRENT_RUN)
        CURRENT_RUN.clear()
        if run.get("stop"):
            run["stop"].set()
    if not run:
        return
    try:
        final = os.path.relpath(os.path.join(run["dir"], "result.json"), ROOT)
        if out.get("status") == "ok":
            _atomic_json(os.path.join(run["dir"], "result.json"), out)
            state = {"state": "done", "result": final}
        else:
            state = {"state": "failed", "code": out.get("code"), "message": out.get("message")}
        state["elapsed_s"] = round(time.monotonic() - run["t0"], 1)
        state["passes"] = [os.path.relpath(p, ROOT) for p in run.get("passes", [])]
        _atomic_json(os.path.join(run["dir"], "state.json"),
                     dict(state, attempt_id=run["attempt"], request_sha256=run["sha"], pid=os.getpid()))
        for pdir in run.get("passes", []):
            _atomic_json(os.path.join(pdir, "state.json"),
                         {"state": "superseded", "note": "an interim pass of the request; the answer is stdout and "
                          "%s" % (final if out.get("status") == "ok" else "the request failed"),
                          "request_sha256": run["sha"], "pid": os.getpid()})
    except OSError:
        pass


def _vector_solution(pb, blocks, d):
    """Scalarised vector design -> solution on the original blocks (element 1 carries the block's types)."""
    out, types = {}, {}
    for name, (orig, k) in pb.vec_info["element"].items():
        if k == 1 and orig in pb.spec_vec["blocks"] and name in blocks:
            # the original block (its vector parameters and dimensions as given) with the chosen data types: the
            # scalarised copy carried element 1's scalar Gain and the internal _GainVec, so the solution was not the
            # proven design and fxgraph refused it (side finding); recordings: a
            # vector Reshape / Data Type Duplicate has no block of its own in the optimised design (an identity and
            # a sink, lowered away) and keeps its parameters below
            out[orig] = dict(pb.spec_vec["blocks"][orig],
                             **{kk: v for kk, v in blocks[name].items() if kk.endswith("DataTypeStr")})
            if name in d.otype:
                types[orig] = d.type_str(name)
    for b, p in pb.spec_vec["blocks"].items():   # Mux / Demux / Selector stay as they were
        out.setdefault(b, dict(p))
    return {"blocks": out, "compiled_types": types,
            "vectors": {"scalarised_blocks": len(blocks), "note": "elements of one block share its data types"}}


